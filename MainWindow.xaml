<Window x:Class="OpenTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenTaskbar"
        Title="OpenTaskbar"
        Width="360"
        Height="48"
        MinHeight="48"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        Closed="Window_Closed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <ContextMenu x:Key="DockContextMenu" x:Shared="False" Opened="DockContextMenu_Opened">
            <MenuItem Header="Ayarlar">
                <MenuItem Header="Konum">
                    <MenuItem Header="Sol" Tag="Left" IsCheckable="True" Click="DockPosition_Click" />
                    <MenuItem Header="Orta" Tag="Center" IsCheckable="True" Click="DockPosition_Click" />
                    <MenuItem Header="Sağ" Tag="Right" IsCheckable="True" Click="DockPosition_Click" />
                </MenuItem>
            </MenuItem>
            <Separator Tag="PinnedAppDivider" Visibility="Collapsed" />
            <MenuItem Header="Sabitlemeyi kaldır" CommandParameter="RemovePinnedApp"
                      Visibility="Collapsed" Click="RemovePinnedApp_Click" />
        </ContextMenu>

        <Style x:Key="DockButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#30242A34" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#60242A34" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.48" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#503C5666" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="DockSurface" HorizontalAlignment="Stretch" Padding="8,0"
            Background="#01000000" ContextMenu="{StaticResource DockContextMenu}">
        <ScrollViewer x:Name="DockScrollViewer" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Left"
                      VerticalContentAlignment="Bottom">
            <StackPanel x:Name="DockContents" Orientation="Horizontal" HorizontalAlignment="Left"
                        VerticalAlignment="Bottom">
                <ItemsControl x:Name="PinnedApps">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource DockButton}" Tag="{Binding ExecutablePath}"
                                    Click="PinnedApp_Click" AutomationProperties.Name="{Binding Name}"
                                    ToolTip="{Binding Name}" ContextMenu="{StaticResource DockContextMenu}">
                                <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl x:Name="RunningWindows">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource DockButton}" Tag="{Binding Handle}"
                                    Click="RunningWindow_Click" AutomationProperties.Name="{Binding Title}"
                                    ToolTip="{Binding Title}" ContextMenu="{StaticResource DockContextMenu}">
                                <Grid Width="32" Height="32">
                                    <Image Source="{Binding Icon}" Stretch="Uniform" />
                                    <Ellipse Width="9" Height="9" Fill="#FFE5484D"
                                             Stroke="#FFF8F8F8" StrokeThickness="1"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Visibility="{Binding HasNotification, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="StatusText" Foreground="#FFF0B78A" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
