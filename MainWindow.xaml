<Window x:Class="OpenTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenTaskbar.Services"
        Title="OpenTaskbar"
        Width="360"
        Height="{StaticResource DockWindowHeight}"
        MinHeight="0"
        FontFamily="{StaticResource InterfaceFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        Closed="Window_Closed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <ContextMenu x:Key="AppContextMenu" x:Shared="False" Opened="DockContextMenu_Opened" Closed="DockContextMenu_Closed">
            <Separator Tag="JumpListCommands" Visibility="Collapsed" />
            <MenuItem Header="{local:Loc OpenApplication}" Icon="{StaticResource IconOpen}" Tag="ActivateDockApp" Click="DockAppContextMenu_Click" />
            <MenuItem Header="{local:Loc Pin}" Icon="{StaticResource IconPin}" Tag="PinDockApp" Visibility="Collapsed" Click="PinDockApp_Click" />
            <MenuItem Header="{local:Loc Unpin}" Icon="{StaticResource IconUnpin}" Tag="UnpinDockApp" Visibility="Collapsed" Click="UnpinDockApp_Click" />
            <Separator Tag="RunningCommandsDivider" />
            <MenuItem Header="{local:Loc CloseApplication}" Icon="{StaticResource IconClose}" Tag="CloseDockApp" Click="CloseDockApp_Click" />
            <MenuItem Header="{local:Loc Terminate}" Icon="{StaticResource IconTerminate}" Style="{StaticResource DestructiveMenuItem}" Tag="TerminateDockApp" Click="TerminateDockApp_Click" />
        </ContextMenu>
        <ContextMenu x:Key="DockContextMenu" x:Shared="False" Opened="DockContextMenu_Opened" Closed="DockContextMenu_Closed">
            <MenuItem Header="{local:Loc Settings}" Icon="{StaticResource IconSettings}" Click="OpenSettings_Click" />
            <Separator />
            <MenuItem Header="{local:Loc Exit}" Icon="{StaticResource IconExit}" Click="ExitOpenTaskbar_Click" />
        </ContextMenu>

        <Style x:Key="DockButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="{DynamicResource DockCellSize}" />
            <Setter Property="Height" Value="{DynamicResource DockCellHeight}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.95" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0"
                                CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="6" />
                                </Grid.RowDefinitions>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse x:Name="ActiveIndicator" Grid.Row="1" Height="4" Width="4"
                                         Fill="{DynamicResource IndicatorBrush}" VerticalAlignment="Center"
                                         HorizontalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfacePressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.48" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceKeyboardFocus}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsForeground}" Value="True">
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1.0" />
                                <Setter TargetName="ActiveIndicator" Property="Width" Value="5" />
                                <Setter TargetName="ActiveIndicator" Property="Height" Value="5" />
                                <Setter TargetName="ActiveIndicator" Property="Fill" Value="{DynamicResource IndicatorForegroundBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewCloseButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceDanger}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceDanger}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DockAppIconTemplate">
            <Button Style="{StaticResource DockButton}" Tag="{Binding ExecutablePath}"
                    Click="DockApp_Click" AutomationProperties.Name="{Binding Name}"
                    ToolTip="{Binding Name}" ToolTipService.InitialShowDelay="650" ContextMenu="{StaticResource AppContextMenu}"
                    Loaded="DockAppButton_Loaded"
                    PreviewMouseLeftButtonDown="DockApp_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="DockApp_PreviewMouseLeftButtonUp"
                    PreviewMouseMove="DockApp_PreviewMouseMove"
                    PreviewKeyDown="DockApp_PreviewKeyDown"
                    AllowDrop="True"
                    Drop="DockApp_Drop"
                    DragOver="DockApp_DragOver"
                    MouseEnter="DockApp_MouseEnter" MouseLeave="DockApp_MouseLeave">
                <Grid Width="{DynamicResource DockIconSize}" Height="{DynamicResource DockIconSize}"
                      RenderTransformOrigin="0.5,0.95">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                            <TranslateTransform Y="0" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource NotificationBrush}"
                             Stroke="{DynamicResource SurfacePopup}" StrokeThickness="1"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Visibility="{Binding HasNotification, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="DockHost">
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding Source={StaticResource DockHeadroom}}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Catches clicks only while the shelf area is reserved (auto-hide off); otherwise windows below stay clickable. -->
        <Border x:Name="DockBackdrop" Grid.Row="1" Background="#01000000" ContextMenu="{StaticResource DockContextMenu}" />
        <Border x:Name="DockSurface" Grid.Row="1" HorizontalAlignment="Stretch" Padding="{StaticResource DockPadding}"
                Margin="{StaticResource DockInset}" VerticalAlignment="Bottom"
                Background="{DynamicResource DockMaterial}" BorderBrush="{DynamicResource DockBorderMaterial}" BorderThickness="1"
                CornerRadius="{StaticResource DockRadius}" ContextMenu="{StaticResource DockContextMenu}"
                MouseEnter="DockSurface_MouseEnter" MouseMove="DockSurface_MouseMove" MouseLeave="DockSurface_MouseLeave">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DockSurfaceTranslate" Y="0" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.38" RenderingBias="Performance" />
            </Border.Effect>
        <Grid x:Name="DockLayoutRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="WidgetColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
        <StackPanel x:Name="DockContents" Orientation="Horizontal" HorizontalAlignment="Left"
                    VerticalAlignment="Center">
            <Button x:Name="StartButton" Style="{StaticResource DockButton}" Click="StartButton_Click"
                    AutomationProperties.Name="{local:Loc Start}" ToolTip="{local:Loc Start}" ToolTipService.InitialShowDelay="650">
                <Grid Width="{DynamicResource DockIconSize}" Height="{DynamicResource DockIconSize}"
                      RenderTransformOrigin="0.5,0.95">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                            <TranslateTransform Y="0" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Path Width="24" Height="24" Stretch="Uniform" Fill="{DynamicResource WindowsLogoBrush}"
                          Data="M0,0 H10 V10 H0 Z M12,0 H22 V10 H12 Z M0,12 H10 V22 H0 Z M12,12 H22 V22 H12 Z" />
                </Grid>
            </Button>
            <Border Width="1" Height="22" Background="{DynamicResource StrokeSubtle}" Margin="3,0,4,0" />
            <ItemsControl x:Name="PinnedApps" ItemTemplate="{StaticResource DockAppIconTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border x:Name="RunningAppsDivider" Width="1" Height="22" Background="{DynamicResource StrokeSubtle}" Margin="4,0,4,0" Visibility="Collapsed" />
            <ItemsControl x:Name="RunningApps" ItemTemplate="{StaticResource DockAppIconTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource DangerText}" FontSize="{StaticResource TextSizeCaption}"
                       MaxWidth="280" VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
            <!-- Widgets follow the apps in floating mode and pin to the right edge in full-width mode. -->
            <StackPanel x:Name="WidgetStrip" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Left" Margin="6,0,0,0" SizeChanged="WidgetStrip_SizeChanged" />
        </Grid>
    </Border>
    <Border x:Name="DockEdgeTrigger" Grid.Row="1" VerticalAlignment="Bottom" Height="{StaticResource DockEdgeTriggerHeight}" Background="#01000000"
            MouseEnter="DockEdgeTrigger_MouseEnter" MouseLeave="DockEdgeTrigger_MouseLeave" />
    </Grid>
</Window>
