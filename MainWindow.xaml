<Window x:Class="OpenTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenTaskbar"
        Title="OpenTaskbar"
        Width="900"
        Height="112"
        MinWidth="360"
        MinHeight="112"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SourceInitialized="Window_SourceInitialized"
        Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#F0181D26" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FF343B47" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFF4F5F7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FFA0A8B5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF9CD7C8" />

        <Style x:Key="DockButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FF242A34" />
            <Setter Property="BorderBrush" Value="#FF3A4350" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FF303947" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FF171B22" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.48" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10,8,10,10" Padding="10,8" CornerRadius="18"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left" Text="OpenTaskbar" Foreground="{StaticResource MutedBrush}"
                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,12,0" />
                <Button x:Name="PinButton" DockPanel.Dock="Right" Style="{StaticResource DockButton}"
                        Content="+ Sabitle" Click="PinButton_Click" AutomationProperties.Name="Uygulama sabitle" />
                <ScrollViewer DockPanel.Dock="Left" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="PinnedApps">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DockButton}" Content="{Binding Name}"
                                        Tag="{Binding ExecutablePath}" Click="PinnedApp_Click"
                                        AutomationProperties.Name="{Binding Name}" ToolTip="{Binding ExecutablePath}">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Sabitlemeyi kaldır" Tag="{Binding ExecutablePath}"
                                                      Click="RemovePinnedApp_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <Border Grid.Row="1" Background="{StaticResource BorderBrush}" Margin="2,7" />

            <DockPanel Grid.Row="2" LastChildFill="True" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left" Text="Açık pencereler" Foreground="{StaticResource MutedBrush}"
                           FontSize="11" VerticalAlignment="Center" Margin="2,0,12,0" />
                <TextBlock x:Name="EmptyState" Text="Açık uygulama bulunamadı" Foreground="{StaticResource MutedBrush}"
                           FontSize="12" VerticalAlignment="Center" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RunningWindows">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DockButton}" Content="{Binding Title}"
                                        Tag="{Binding Handle}" Click="RunningWindow_Click"
                                        AutomationProperties.Name="{Binding Title}" ToolTip="Pencereye geç" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="#FFF0B78A" FontSize="11"
                       Margin="2,4,2,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
