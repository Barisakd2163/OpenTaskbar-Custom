<Window x:Class="OpenTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenTaskbar"
        Title="OpenTaskbar"
        Width="360"
        Height="{StaticResource DockWindowHeight}"
        MinHeight="0"
        FontFamily="{StaticResource InterfaceFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        Closed="Window_Closed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
            <Setter Property="FontSize" Value="{StaticResource TextSizeBody}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="ItemSurface" Background="{TemplateBinding Background}"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{TemplateBinding Icon}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                      VerticalAlignment="Center" />
                                    <TextBlock x:Name="Checkmark" Grid.Column="2" Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Visibility="Collapsed" />
                                    <TextBlock x:Name="SubmenuArrow" Grid.Column="2" Text="&#xE76C;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   Placement="Right" PopupAnimation="None"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{StaticResource MenuMaterial}" BorderBrush="{StaticResource MenuStroke}"
                                        BorderThickness="1" CornerRadius="{StaticResource PopupRadius}" Padding="5">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Checkmark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemSurface" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Margin" Value="9,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{StaticResource MenuStroke}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="StaysOpen" Value="False" />
            <Setter Property="Background" Value="{StaticResource MenuMaterial}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource MenuStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="MinWidth" Value="224" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource PopupRadius}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ContextMenu x:Key="AppContextMenu" x:Shared="False" Opened="DockContextMenu_Opened" Closed="DockContextMenu_Closed">
            <MenuItem Header="Uygulamayı aç" Icon="&#xE8A7;" Tag="ActivateDockApp" Click="DockAppContextMenu_Click" />
            <MenuItem Header="Tarayıcı işlemleri" Icon="&#xE774;" Tag="BrowserActions" Visibility="Collapsed">
                <MenuItem Header="Yeni pencere" Icon="&#xE78B;" Tag="NewWindow" Click="BrowserAction_Click" />
                <MenuItem Header="Gizli pencere" Icon="&#xE72E;" Tag="PrivateWindow" Click="BrowserAction_Click" />
            </MenuItem>
            <MenuItem Header="Uygulama komutları" Icon="&#xE8A7;" Tag="NativeAppCommands" Visibility="Collapsed" />
            <MenuItem Header="Pencere komutları" Icon="&#xE737;" Tag="NativeWindowCommands" Visibility="Collapsed" />
            <MenuItem Header="Sabitlemeyi kaldır" Icon="&#xE77A;" Tag="UnpinDockApp" Visibility="Collapsed" Click="UnpinDockApp_Click" />
            <Separator Tag="RunningCommandsDivider" />
            <MenuItem Header="Uygulamayı kapat" Icon="&#xE711;" Tag="CloseDockApp" Click="CloseDockApp_Click" />
            <MenuItem Header="Süreci sonlandır…" Icon="&#xE7BA;" Tag="TerminateDockApp" Click="TerminateDockApp_Click" />
        </ContextMenu>
        <ContextMenu x:Key="DockContextMenu" x:Shared="False" Opened="DockContextMenu_Opened" Closed="DockContextMenu_Closed">
            <MenuItem Header="Görev çubuğu konumu" Icon="&#xE713;" Tag="DockSettings">
                <MenuItem Header="Sol" Icon="&#xE8E4;" Tag="Left" IsCheckable="True" Click="DockPosition_Click" />
                <MenuItem Header="Orta" Icon="&#xE8E3;" Tag="Center" IsCheckable="True" Click="DockPosition_Click" />
                <MenuItem Header="Sağ" Icon="&#xE8E2;" Tag="Right" IsCheckable="True" Click="DockPosition_Click" />
            </MenuItem>
        </ContextMenu>

        <Style x:Key="DockButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="{DynamicResource DockCellSize}" />
            <Setter Property="Height" Value="{DynamicResource DockCellHeight}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="5" />
                                </Grid.RowDefinitions>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border x:Name="ActiveIndicator" Grid.Row="1" Height="3" Width="5" CornerRadius="2"
                                        Background="{StaticResource IndicatorBrush}" VerticalAlignment="Top"
                                        HorizontalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfacePressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.48" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceKeyboardFocus}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="0.42" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsForeground}" Value="True">
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1" />
                                <Setter TargetName="ActiveIndicator" Property="Width" Value="16" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewCloseButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource SurfaceSelected}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceDanger}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceDanger}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DockAppIconTemplate">
            <Button Style="{StaticResource DockButton}" Tag="{Binding ExecutablePath}"
                    Click="DockApp_Click" AutomationProperties.Name="{Binding Name}"
                    ToolTip="{Binding Name}" ToolTipService.InitialShowDelay="650" ContextMenu="{StaticResource AppContextMenu}"
                    Loaded="DockAppButton_Loaded"
                    MouseEnter="DockApp_MouseEnter" MouseLeave="DockApp_MouseLeave"
                    RenderTransformOrigin="0.5,0.5">
                <Grid Width="{DynamicResource DockIconSize}" Height="{DynamicResource DockIconSize}">
                    <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Ellipse Width="9" Height="9" Fill="{StaticResource NotificationBrush}"
                             Stroke="{StaticResource SurfacePopup}" StrokeThickness="1"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Visibility="{Binding HasNotification, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="DockHost" Background="#01000000" ContextMenu="{StaticResource DockContextMenu}">
    <Border x:Name="DockSurface" HorizontalAlignment="Stretch" Padding="{StaticResource DockPadding}"
            Margin="{StaticResource DockInset}" VerticalAlignment="Center"
            Background="{StaticResource DockMaterial}" BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="1"
            CornerRadius="{StaticResource DockRadius}" ContextMenu="{StaticResource DockContextMenu}"
            MouseMove="DockSurface_MouseMove" MouseLeave="DockSurface_MouseLeave">
        <StackPanel x:Name="DockContents" Orientation="Horizontal" HorizontalAlignment="Left"
                    VerticalAlignment="Center">
            <Button x:Name="StartButton" Style="{StaticResource DockButton}" Click="StartButton_Click"
                    AutomationProperties.Name="Başlat" ToolTip="Başlat" ToolTipService.InitialShowDelay="650">
                <Path Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource WindowsLogoBrush}"
                      Data="M0,0 H10 V10 H0 Z M12,0 H22 V10 H12 Z M0,12 H10 V22 H0 Z M12,12 H22 V22 H12 Z" />
            </Button>
            <Border Width="1" Height="22" Background="{StaticResource StrokeSubtle}" Margin="4,0,5,0" />
            <ItemsControl x:Name="PinnedApps" ItemTemplate="{StaticResource DockAppIconTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ItemsControl x:Name="RunningApps" ItemTemplate="{StaticResource DockAppIconTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock x:Name="StatusText" Foreground="#FFF0B78A" FontSize="{StaticResource TextSizeCaption}"
                       MaxWidth="280" VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
    </Grid>
</Window>
