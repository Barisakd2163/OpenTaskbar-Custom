<w:DockWidget x:Class="OpenTaskbar.Widgets.SystemStatsWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:OpenTaskbar.Widgets"
              xmlns:local="clr-namespace:OpenTaskbar.Services">
    <StackPanel Orientation="Horizontal">
        <Button x:Name="CompactSummaryButton" Style="{StaticResource WidgetCardButton}" Width="82" Padding="7,2"
                Visibility="Collapsed" Click="TaskManager_Click">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CompactCpuText" Style="{StaticResource WidgetText}" FontSize="11"
                           Typography.NumeralAlignment="Tabular" Text="CPU —" />
                <TextBlock x:Name="CompactRamText" Style="{StaticResource WidgetCaption}" FontSize="10.5"
                           Typography.NumeralAlignment="Tabular" Text="RAM —" Margin="0,-1,0,0" />
            </StackPanel>
        </Button>
        <Button x:Name="BatteryButton" Style="{StaticResource WidgetCardButton}" Width="{StaticResource WidgetHeight}"
                Padding="3" Visibility="Collapsed" Click="BatteryButton_Click">
            <Grid>
                <w:RingMeter x:Name="BatteryRing" Width="38" Height="38" StrokeThickness="3" FontSize="11.5" Caption="BAT"
                             CaptionBrush="{DynamicResource TextSecondary}" TrackBrush="{DynamicResource WidgetTrack}"
                             ValueBrush="{DynamicResource WidgetAccent}" Foreground="{DynamicResource TextPrimary}" />
                <ContentControl x:Name="ChargingIcon" Style="{StaticResource WidgetIcon}" Content="{StaticResource IconZap}"
                                Width="9" Height="9" Foreground="{DynamicResource WidgetAccent}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0" Visibility="Collapsed" />
            </Grid>
        </Button>
        <Button x:Name="CpuButton" Style="{StaticResource WidgetCardButton}" Width="{StaticResource WidgetHeight}" Padding="3"
                Click="TaskManager_Click">
            <w:RingMeter x:Name="CpuRing" Width="38" Height="38" StrokeThickness="3" FontSize="11.5" Caption="CPU" CaptionBrush="{DynamicResource TextSecondary}"
                         TrackBrush="{DynamicResource WidgetTrack}" ValueBrush="{DynamicResource WidgetAccent}"
                         Foreground="{DynamicResource TextPrimary}" />
        </Button>
        <Button x:Name="MemoryButton" Style="{StaticResource WidgetCardButton}" Width="{StaticResource WidgetHeight}" Padding="3"
                Click="TaskManager_Click">
            <w:RingMeter x:Name="MemoryRing" Width="38" Height="38" StrokeThickness="3" FontSize="11.5" Caption="RAM" CaptionBrush="{DynamicResource TextSecondary}"
                         TrackBrush="{DynamicResource WidgetTrack}" ValueBrush="{DynamicResource WidgetAccent}"
                         Foreground="{DynamicResource TextPrimary}" />
        </Button>
        <Button x:Name="CpuTemperatureButton" Style="{StaticResource WidgetCardButton}" Width="{StaticResource WidgetHeight}" Padding="3"
                Visibility="Collapsed" Click="TaskManager_Click">
            <w:RingMeter x:Name="CpuTemperatureRing" Width="38" Height="38" StrokeThickness="3" FontSize="11.5" Caption="CPU°" CaptionBrush="{DynamicResource TextSecondary}"
                         TrackBrush="{DynamicResource WidgetTrack}" ValueBrush="{DynamicResource WidgetAccent}"
                         Foreground="{DynamicResource TextPrimary}" />
        </Button>
        <Button x:Name="GpuButton" Style="{StaticResource WidgetCardButton}" Width="{StaticResource WidgetHeight}" Padding="3"
                Visibility="Collapsed" Click="TaskManager_Click">
            <w:RingMeter x:Name="GpuRing" Width="38" Height="38" StrokeThickness="3" FontSize="11.5" Caption="GPU" CaptionBrush="{DynamicResource TextSecondary}"
                         TrackBrush="{DynamicResource WidgetTrack}" ValueBrush="{DynamicResource WidgetAccent}"
                         Foreground="{DynamicResource TextPrimary}" />
        </Button>
        <Button x:Name="GpuTemperatureButton" Style="{StaticResource WidgetCardButton}" Width="{StaticResource WidgetHeight}" Padding="3"
                Visibility="Collapsed" Click="TaskManager_Click">
            <w:RingMeter x:Name="GpuTemperatureRing" Width="38" Height="38" StrokeThickness="3" FontSize="11.5" Caption="GPU°" CaptionBrush="{DynamicResource TextSecondary}"
                         TrackBrush="{DynamicResource WidgetTrack}" ValueBrush="{DynamicResource WidgetAccent}"
                         Foreground="{DynamicResource TextPrimary}" />
        </Button>
    </StackPanel>
</w:DockWidget>
