<w:DockWidget x:Class="OpenTaskbar.Widgets.SystemStatsWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:OpenTaskbar.Widgets"
              xmlns:local="clr-namespace:OpenTaskbar.Services">
    <Button x:Name="StatsCardButton" Style="{StaticResource WidgetCardButton}" Padding="8,0"
            Click="StatsCardButton_Click"
            AutomationProperties.Name="{local:Loc WidgetSystemStats}">
        <StackPanel x:Name="MetricsPanel" Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="CpuButton" VerticalAlignment="Center" MinWidth="32">
                <StackPanel>
                    <TextBlock x:Name="CpuLabel" Text="CPU" FontSize="10" LineHeight="11"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock x:Name="CpuValueText" Text="—" FontSize="12" FontWeight="SemiBold" LineHeight="15"
                               Foreground="{DynamicResource TextPrimary}" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Border>

            <Border x:Name="RamDivider" Width="1" Height="22" Background="{DynamicResource StrokeSubtle}"
                    Margin="3,0" VerticalAlignment="Center" />
            <Border x:Name="MemoryButton" VerticalAlignment="Center" MinWidth="32">
                <StackPanel>
                    <TextBlock x:Name="RamLabel" Text="RAM" FontSize="10" LineHeight="11"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock x:Name="RamValueText" Text="—" FontSize="12" FontWeight="SemiBold" LineHeight="15"
                               Foreground="{DynamicResource TextPrimary}" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Border>

            <Border x:Name="GpuDivider" Width="1" Height="22" Background="{DynamicResource StrokeSubtle}"
                    Margin="3,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <Border x:Name="GpuButton" VerticalAlignment="Center" MinWidth="32" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="GpuLabel" Text="GPU" FontSize="10" LineHeight="11"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock x:Name="GpuValueText" Text="—" FontSize="12" FontWeight="SemiBold" LineHeight="15"
                               Foreground="{DynamicResource TextPrimary}" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Border>

            <Border x:Name="GpuTempDivider" Width="1" Height="22" Background="{DynamicResource StrokeSubtle}"
                    Margin="3,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <Border x:Name="GpuTemperatureButton" VerticalAlignment="Center" MinWidth="32" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="GpuTempLabel" Text="GPU °C" FontSize="10" LineHeight="11"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock x:Name="GpuTempValueText" Text="—" FontSize="12" FontWeight="SemiBold" LineHeight="15"
                               Foreground="{DynamicResource TextPrimary}" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Button>
</w:DockWidget>
