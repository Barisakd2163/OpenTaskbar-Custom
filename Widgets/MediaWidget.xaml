<w:DockWidget x:Class="OpenTaskbar.Widgets.MediaWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:OpenTaskbar.Widgets"
              xmlns:local="clr-namespace:OpenTaskbar.Services">
    <Border x:Name="Card" Style="{StaticResource WidgetCardBorder}" Width="264" Padding="6,0,4,0">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="7" Background="{DynamicResource WidgetTrack}" ClipToBounds="True">
                <Grid>
                    <ContentControl x:Name="ArtPlaceholder" Style="{StaticResource WidgetIcon}" Content="{StaticResource IconMusic}"
                                    Foreground="{DynamicResource TextSecondary}" />
                    <Image x:Name="ArtImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,34,34" RadiusX="7" RadiusY="7" />
                        </Image.Clip>
                    </Image>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource WidgetText}" />
                <TextBlock x:Name="ArtistText" Style="{StaticResource WidgetCaption}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="PreviousButton" Style="{StaticResource WidgetIconButton}" Click="Previous_Click"
                        ToolTip="{local:Loc MediaPrevious}" AutomationProperties.Name="{local:Loc MediaPrevious}">
                    <ContentControl Style="{StaticResource WidgetGlyph}" Content="{StaticResource IconPreviousFill}" Width="12" Height="12" />
                </Button>
                <Button x:Name="PlayPauseButton" Style="{StaticResource WidgetIconButton}" Width="30" Height="30" Click="PlayPause_Click"
                        ToolTip="{local:Loc MediaPlayPause}" AutomationProperties.Name="{local:Loc MediaPlayPause}">
                    <ContentControl x:Name="PlayPauseGlyph" Style="{StaticResource WidgetGlyph}" Content="{StaticResource IconPlayFill}" Width="15" Height="15" />
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource WidgetIconButton}" Click="Next_Click"
                        ToolTip="{local:Loc MediaNext}" AutomationProperties.Name="{local:Loc MediaNext}">
                    <ContentControl Style="{StaticResource WidgetGlyph}" Content="{StaticResource IconNextFill}" Width="12" Height="12" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</w:DockWidget>
