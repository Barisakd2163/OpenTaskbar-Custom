<w:DockWidget x:Class="OpenTaskbar.Widgets.AudioWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:OpenTaskbar.Widgets"
              xmlns:local="clr-namespace:OpenTaskbar.Services">
    <Border x:Name="Card" Style="{StaticResource WidgetCardBorder}" Width="200" Padding="6,0,12,0" MouseWheel="Card_MouseWheel">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button x:Name="MuteButton" Style="{StaticResource WidgetIconButton}" Width="24" Height="24" Click="MuteButton_Click"
                    ToolTip="{local:Loc MuteToggle}" AutomationProperties.Name="{local:Loc MuteToggle}">
                <ContentControl x:Name="VolumeIcon" Style="{StaticResource WidgetIcon}" Content="{StaticResource IconVolume}" Width="15" Height="15" />
            </Button>
            <TextBlock x:Name="DeviceText" Grid.Column="1" Style="{StaticResource WidgetText}" Margin="4,0,6,0" FontSize="11.5" />
            <TextBlock x:Name="LevelText" Grid.Column="2" Style="{StaticResource WidgetCaption}" />
            <Slider x:Name="VolumeSlider" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource WidgetSlider}" Margin="6,2,0,0"
                    ValueChanged="VolumeSlider_ValueChanged" AutomationProperties.Name="{local:Loc Volume}" />
        </Grid>
    </Border>
</w:DockWidget>
