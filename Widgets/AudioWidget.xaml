<w:DockWidget x:Class="OpenTaskbar.Widgets.AudioWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:OpenTaskbar.Widgets"
              xmlns:local="clr-namespace:OpenTaskbar.Services">
    <Button x:Name="ComboButton" Style="{StaticResource WidgetCardButton}" Padding="10,0"
            Click="ComboButton_Click" MouseWheel="Card_MouseWheel"
            AutomationProperties.Name="{local:Loc WidgetAudio}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ContentControl x:Name="OutputIcon" Style="{StaticResource WidgetIcon}" Content="{StaticResource IconVolume}"
                            Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0"
                            Foreground="{DynamicResource TextPrimary}" />
            <TextBlock x:Name="VolumeText" Style="{StaticResource WidgetText}" Text="—"
                       FontSize="12.5" FontWeight="SemiBold" MinWidth="34" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" Typography.NumeralAlignment="Tabular" />
        </StackPanel>
    </Button>
</w:DockWidget>
