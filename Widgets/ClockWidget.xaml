<w:DockWidget x:Class="OpenTaskbar.Widgets.ClockWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:OpenTaskbar.Widgets"
              xmlns:local="clr-namespace:OpenTaskbar.Services">
    <Button x:Name="ClockButton" Style="{StaticResource WidgetCardButton}" Padding="12,0" Click="ClockButton_Click"
            AutomationProperties.Name="{local:Loc Calendar}">
        <StackPanel>
            <TextBlock x:Name="TimeText" Style="{StaticResource WidgetText}" FontSize="15" HorizontalAlignment="Right" />
            <TextBlock x:Name="DateText" Style="{StaticResource WidgetCaption}" HorizontalAlignment="Right" />
        </StackPanel>
    </Button>
</w:DockWidget>
