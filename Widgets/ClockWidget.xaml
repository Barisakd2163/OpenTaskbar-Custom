<w:DockWidget x:Class="OpenTaskbar.Widgets.ClockWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:OpenTaskbar.Widgets"
              xmlns:local="clr-namespace:OpenTaskbar.Services">
    <Button x:Name="ClockButton" Style="{StaticResource WidgetCardButton}" Padding="9,2,11,2" Click="ClockButton_Click"
            AutomationProperties.Name="{local:Loc Calendar}">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Time of Day Icon (Sun / Moon) -->
            <ContentControl x:Name="TimeOfDayIcon" Grid.Column="0"
                            Style="{StaticResource WidgetIcon}"
                            Width="16" Height="16"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0" />

            <!-- Column 1: Day name & Date -->
            <StackPanel x:Name="DateColumn" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock x:Name="DayOfWeekText" FontSize="9" FontWeight="Bold"
                           TextAlignment="Left" HorizontalAlignment="Left" />
                <TextBlock x:Name="DateText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                           TextAlignment="Left" HorizontalAlignment="Left" Margin="0,-1,0,0" />
            </StackPanel>

            <!-- Column 2: Time -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="TimeText" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>
    </Button>
</w:DockWidget>
