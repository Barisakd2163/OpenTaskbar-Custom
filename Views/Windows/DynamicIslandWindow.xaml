<Window x:Class="OpenTaskbar.Views.Windows.DynamicIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:OpenTaskbar.Views.Widgets"
        Width="420" Height="50" MinWidth="240" MaxWidth="960" MinHeight="50" MaxHeight="246"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" AllowsTransparency="True" Background="Transparent" Focusable="False"
        FontFamily="{DynamicResource InterfaceFont}" FontSize="{DynamicResource TextSizeBody}"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseWheel="Window_PreviewMouseWheel"
        Closed="Window_Closed">
    <Grid ClipToBounds="True">
        <Border x:Name="IslandSurface" Background="{DynamicResource DockMaterial}"
                BorderBrush="{DynamicResource DockBorderMaterial}" BorderThickness="1,0,1,1"
                CornerRadius="0,0,20,20" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="Header" Grid.Row="0" Background="Transparent"
                      PreviewMouseLeftButtonDown="Header_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="Header_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="Header_PreviewMouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PreviousButton" Grid.Column="0" Width="32" Height="32" Margin="3,0,0,0"
                            Style="{StaticResource WidgetButton}" Click="Previous_Click"
                            AutomationProperties.Name="{DynamicResource DynamicIslandPrevious}" ToolTip="{DynamicResource DynamicIslandPrevious}">
                        <ContentControl Width="15" Height="15" Content="{StaticResource IconChevronLeft}" Style="{StaticResource WidgetGlyph}" />
                    </Button>
                    <Border x:Name="PageViewport" Grid.Column="1" ClipToBounds="True">
                        <widgets:DynamicIslandPagePanel x:Name="Pages" />
                    </Border>
                    <Button x:Name="NextButton" Grid.Column="2" Width="32" Height="32" Margin="0"
                            Style="{StaticResource WidgetButton}" Click="Next_Click"
                            AutomationProperties.Name="{DynamicResource DynamicIslandNext}" ToolTip="{DynamicResource DynamicIslandNext}">
                        <ContentControl Width="15" Height="15" Content="{StaticResource IconChevronRight}" Style="{StaticResource WidgetGlyph}" />
                    </Button>
                    <TextBlock x:Name="PageCount" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" FontSize="11" Typography.NumeralAlignment="Tabular" />
                    <Button x:Name="ExpandButton" Grid.Column="4" Width="32" Height="32" Margin="0,0,3,0"
                            Style="{StaticResource WidgetButton}" Click="Expand_Click">
                        <ContentControl x:Name="ExpandGlyph" Width="15" Height="15" Content="{StaticResource IconChevronDown}" Style="{StaticResource WidgetGlyph}" />
                    </Button>
                </Grid>

                <Border x:Name="DetailsPanel" Grid.Row="1" Padding="14,2,14,12" Visibility="Collapsed"
                        BorderThickness="0" Background="Transparent">
                    <ScrollViewer x:Name="DetailsScrollViewer" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                                  PreviewMouseLeftButtonDown="Details_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="Details_PreviewMouseMove"
                                  PreviewMouseLeftButtonUp="Details_PreviewMouseLeftButtonUp">
                        <ContentControl x:Name="DetailsContent" HorizontalContentAlignment="Stretch" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
