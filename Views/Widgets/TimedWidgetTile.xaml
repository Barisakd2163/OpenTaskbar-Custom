<UserControl x:Class="OpenTaskbar.Views.Widgets.TimedWidgetTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenTaskbar.Services"
             Focusable="False" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource InterfaceFont}">
    <Border Style="{StaticResource DockWidgetFrame}" MinWidth="{StaticResource TimedWidgetMinimumWidth}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="DetailsButton" Style="{StaticResource WidgetButton}" Padding="0" Click="Details_Click"
                    HorizontalContentAlignment="Left" ToolTip="{local:Loc WidgetOpenDetails}"
                    AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    AutomationProperties.HelpText="{local:Loc WidgetOpenDetails}" AutomationProperties.ItemStatus="{Binding Value}">
                <StackPanel>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource TextSizeWidgetLabel}" />
                    <TextBlock x:Name="ValueText" Typography.NumeralAlignment="Tabular" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Value}" />
                                <Setter Property="FontSize" Value="{StaticResource TextSizeTimedWidgetValue}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Value}" Value="">
                                        <Setter Property="Text" Value="{local:Loc WidgetSetDuration}" />
                                        <Setter Property="FontSize" Value="{StaticResource TextSizeBody}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="QuickActionButton" Grid.Column="1" Style="{StaticResource WidgetQuickAction}"
                    Margin="{StaticResource DockWidgetActionMargin}" VerticalAlignment="Center" Click="QuickAction_Click" />
        </Grid>
    </Border>
</UserControl>
