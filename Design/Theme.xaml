<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Neutral materials preserve application icon colors and wallpaper visibility. -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF1F3F5" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FFADB5BF" />
    <SolidColorBrush x:Key="SurfacePopup" Color="#FF181C22" />
    <SolidColorBrush x:Key="StrokeSubtle" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="StrokeFocus" Color="#FFD0E8FA" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="SurfacePressed" Color="#3AFFFFFF" />
    <SolidColorBrush x:Key="SurfaceSelected" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="SurfaceDanger" Color="#FFC43846" />
    <SolidColorBrush x:Key="NotificationBrush" Color="#FFFF6673" />
    <SolidColorBrush x:Key="IndicatorBrush" Color="#FFE4F3FF" />
    <LinearGradientBrush x:Key="DockMaterial" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A02B323B" Offset="0" />
        <GradientStop Color="#B5161B22" Offset="1" />
    </LinearGradientBrush>
    <FontFamily x:Key="InterfaceFont">Segoe UI</FontFamily>
    <sys:Double x:Key="TextSizeBody">13</sys:Double>
    <sys:Double x:Key="TextSizeCaption">12</sys:Double>
    <sys:Double x:Key="DockWindowHeight">48</sys:Double>
    <sys:Double x:Key="DockCellSize">44</sys:Double>
    <sys:Double x:Key="DockIconSize">28</sys:Double>
    <sys:Double x:Key="PreviewWidth">344</sys:Double>
    <sys:Double x:Key="PreviewHeight">236</sys:Double>
    <sys:Double x:Key="PreviewHeaderHeight">40</sys:Double>
    <sys:Double x:Key="DockHoverScale">1.22</sys:Double>
    <sys:Double x:Key="DockNeighborScale">1.08</sys:Double>
    <sys:Double x:Key="HoverDurationMs">120</sys:Double>
    <sys:Double x:Key="PreviewDurationMs">160</sys:Double>
    <Thickness x:Key="DockInset">4,0</Thickness>
    <Thickness x:Key="DockPadding">6,1</Thickness>
    <Thickness x:Key="ControlStroke">1</Thickness>
    <CornerRadius x:Key="DockRadius">13</CornerRadius>
    <CornerRadius x:Key="ControlRadius">10</CornerRadius>
    <CornerRadius x:Key="PopupRadius">10</CornerRadius>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SurfacePopup}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
        <Setter Property="FontSize" Value="{StaticResource TextSizeCaption}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtle}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
</ResourceDictionary>
