<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palettes/Dark.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <FontFamily x:Key="InterfaceFont">Segoe UI</FontFamily>
    <sys:Double x:Key="MenuLabelWidth">286</sys:Double>
    <Thickness x:Key="MenuRowPadding">10,7</Thickness>
    <Thickness x:Key="MenuDividerInset">12,7</Thickness>
    <sys:Double x:Key="TextSizeBody">13</sys:Double>
    <sys:Double x:Key="TextSizeCaption">12</sys:Double>
    <sys:Double x:Key="TextSizeWidgetLabel">11</sys:Double>
    <sys:Double x:Key="DockScrollBarHeight">4</sys:Double>
    <sys:Double x:Key="DockScrollThumbMinWidth">24</sys:Double>
    <sys:Double x:Key="DockResizeGripWidth">8</sys:Double>
    <Thickness x:Key="DockResizeGripInset">1,10</Thickness>
    <Thickness x:Key="DockScrollThumbMargin">3,1</Thickness>
    <Thickness x:Key="DockWidgetPadding">9,5</Thickness>
    <sys:Double x:Key="DockHeadroom">24</sys:Double>
    <sys:Double x:Key="DockWindowHeight">98</sys:Double>
    <sys:Double x:Key="DockCellSize">52</sys:Double>
    <sys:Double x:Key="DockMinimumCellSize">24</sys:Double>
    <sys:Double x:Key="DockMaximumCellSize">52</sys:Double>
    <sys:Double x:Key="DockCellHeight">52</sys:Double>
    <sys:Double x:Key="DockIconSize">42</sys:Double>
    <sys:Double x:Key="DockMaximumIconSize">42</sys:Double>
    <sys:Double x:Key="DockIconCellInset">8</sys:Double>
    <sys:Double x:Key="TextSizeWidgetValue">14</sys:Double>
    <sys:Double x:Key="DockMinimumWidth">280</sys:Double>
    <sys:Double x:Key="DockAbsoluteMinimumWidth">16</sys:Double>
    <sys:Double x:Key="DockContentOverflowAllowance">32</sys:Double>
    <sys:Double x:Key="DockFrameWidthAllowance">12</sys:Double>
    <sys:Double x:Key="PreviewWidth">344</sys:Double>
    <sys:Double x:Key="PreviewHeight">236</sys:Double>
    <sys:Double x:Key="PreviewHeaderHeight">40</sys:Double>
    <sys:Double x:Key="PreviewGap">18</sys:Double>
    <sys:Double x:Key="DockHoverScale">1.28</sys:Double>
    <sys:Double x:Key="HoverDurationMs">120</sys:Double>
    <sys:Double x:Key="PreviewDurationMs">160</sys:Double>
    <Thickness x:Key="DockInset">12,0,12,6</Thickness>
    <Thickness x:Key="DockPadding">10,4</Thickness>
    <Thickness x:Key="ControlStroke">1</Thickness>
    <CornerRadius x:Key="DockRadius">18</CornerRadius>
    <CornerRadius x:Key="ControlRadius">12</CornerRadius>
    <CornerRadius x:Key="DockWidgetRadius">10</CornerRadius>
    <CornerRadius x:Key="DockScrollThumbRadius">3</CornerRadius>
    <CornerRadius x:Key="PopupRadius">10</CornerRadius>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfacePopup}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
        <Setter Property="FontSize" Value="{DynamicResource TextSizeCaption}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Margin="4,2" MinHeight="24">
                                <Thumb.Style>
                                    <Style TargetType="Thumb">
                                        <Setter Property="Background" Value="{DynamicResource MenuDivider}" />
                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="2" /></ControlTemplate></Setter.Value></Setter>
                                        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource TextSecondary}" /></Trigger></Style.Triggers>
                                    </Style>
                                </Thumb.Style>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lucide Vector Icon Geometries (24x24 outline coordinate space) -->
    <StreamGeometry x:Key="IconOpen">M15 3h6v6 M10 14L21 3 M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6</StreamGeometry>
    <StreamGeometry x:Key="IconPin">M12 17v5 M9 10.76a2 2 0 0 1-1.11 1.79l-1.78 0.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-0.76a2 2 0 0 0-1.11-1.79l-1.78-0.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z</StreamGeometry>
    <StreamGeometry x:Key="IconUnpin">M12 17v5 M15 9.34V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H7.89 M2 2l20 20 M9 9v1.76a2 2 0 0 1-1.11 1.79l-1.78 0.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h11</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M18 6L6 18 M6 6l12 12</StreamGeometry>
    <StreamGeometry x:Key="IconTerminate">M7.86 2h8.28L22 7.86v8.28L16.14 22H7.86L2 16.14V7.86L7.86 2z M12 8v4 M12 16h0.01</StreamGeometry>
    <StreamGeometry x:Key="IconSettings">M21 4h-7 M10 4H3 M14 2v4 M21 12h-9 M8 12H3 M12 10v4 M21 20h-5 M12 20H3 M16 18v4</StreamGeometry>
    <StreamGeometry x:Key="IconAlignLeft">M21 6H3 M15 12H3 M17 18H3</StreamGeometry>
    <StreamGeometry x:Key="IconAlignCenter">M21 6H3 M17 12H7 M19 18H5</StreamGeometry>
    <StreamGeometry x:Key="IconAlignRight">M21 6H3 M21 12H9 M21 18H7</StreamGeometry>
    <StreamGeometry x:Key="IconExit">M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16 17l5-5-5-5 M21 12H9</StreamGeometry>
    <StreamGeometry x:Key="IconCheck">M20 6L9 17l-5-5</StreamGeometry>
    <StreamGeometry x:Key="IconChevronRight">M9 18l6-6-6-6</StreamGeometry>

    <!-- Vector Icon DataTemplate for MenuItems -->
    <DataTemplate DataType="{x:Type Geometry}">
        <Path Data="{Binding}"
              Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
              StrokeThickness="1.6"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round"
              Width="14"
              Height="14"
              Stretch="Uniform"
              SnapsToDevicePixels="True"
              VerticalAlignment="Center"
              HorizontalAlignment="Center" />
    </DataTemplate>
</ResourceDictionary>
