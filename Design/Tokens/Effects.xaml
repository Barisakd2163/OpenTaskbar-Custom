<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Performance bias is essential: the dock resizes every frame during fisheye
         magnification, so a software-rasterized shadow is the single biggest judder source. -->
    <DropShadowEffect x:Key="ShadowDock" BlurRadius="20" ShadowDepth="4" Direction="270"
                      Color="#000000" Opacity="0.28" RenderingBias="Performance" />
    <DropShadowEffect x:Key="ShadowMenu" BlurRadius="24" ShadowDepth="6" Direction="270"
                      Color="#000000" Opacity="0.5" RenderingBias="Performance" />
</ResourceDictionary>
