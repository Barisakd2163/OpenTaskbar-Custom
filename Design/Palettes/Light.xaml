<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Neutral materials preserve application icon colors and wallpaper visibility. -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FF202329" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FF5E6570" />
    <LinearGradientBrush x:Key="WindowsLogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF14B8A6" Offset="0" />
        <GradientStop Color="#FF0284C7" Offset="0.55" />
        <GradientStop Color="#FF6366F1" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="IconHoverGlow" GradientOrigin="0.5,0.8" Center="0.5,0.75" RadiusX="0.6" RadiusY="0.6">
        <GradientStop Color="#300284C7" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="DockHighlight" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#FFFFFFFF" Offset="0.4" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WidgetIsland" Color="#0A000000" />
    <SolidColorBrush x:Key="WidgetIslandStroke" Color="#12000000" />
    <SolidColorBrush x:Key="SurfaceKeyboardFocus" Color="#FFCFDFEC" />
    <SolidColorBrush x:Key="MenuStroke" Color="#26000000" />
    <LinearGradientBrush x:Key="MenuMaterial" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F9FCFCFD" Offset="0" />
        <GradientStop Color="#FAF2F3F5" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfacePopup" Color="#FFF8F9FB" />
    <SolidColorBrush x:Key="StrokeSubtle" Color="#20000000" />
    <SolidColorBrush x:Key="StrokeFocus" Color="#FF457DA8" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#12000000" />
    <SolidColorBrush x:Key="SurfacePressed" Color="#20000000" />
    <SolidColorBrush x:Key="SurfaceSelected" Color="#0C000000" />
    <SolidColorBrush x:Key="DockWidgetSurface" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="SurfaceSelectedStrong" Color="#1F1F6FD1" />
    <SolidColorBrush x:Key="SurfaceDanger" Color="#FFC43846" />
    <SolidColorBrush x:Key="NotificationBrush" Color="#FFD22D42" />
    <SolidColorBrush x:Key="IndicatorBrush" Color="#AA303A47" />
    <LinearGradientBrush x:Key="IndicatorForegroundBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0D9488" Offset="0" />
        <GradientStop Color="#FF0284C7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DockMaterial" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F4F6F7FA" Offset="0" />
        <GradientStop Color="#F7F3F4F7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DockBorderMaterial" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E0FFFFFF" Offset="0" />
        <GradientStop Color="#26000000" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SettingsBackground" Color="#FFF7F8FA" />
    <SolidColorBrush x:Key="SettingsControl" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SettingsControlHover" Color="#FFE8EBEF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF245D87" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DangerText" Color="#FFAF2338" />
    <SolidColorBrush x:Key="MenuDivider" Color="#20000000" />
    <SolidColorBrush x:Key="SettingsSidebarOverlay" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="CaptionCloseForeground" Color="#FFFFFFFF" />
    <!-- Dock widgets -->
    <SolidColorBrush x:Key="WidgetCard" Color="#00000000" />
    <SolidColorBrush x:Key="WidgetCardHover" Color="#12000000" />
    <SolidColorBrush x:Key="WidgetCardStroke" Color="#00000000" />
    <SolidColorBrush x:Key="WidgetTrack" Color="#1F000000" />
    <SolidColorBrush x:Key="WidgetAccent" Color="#FF0D9488" />
    <SolidColorBrush x:Key="WidgetAccentText" Color="#FFFFFFFF" />
    <LinearGradientBrush x:Key="WidgetAccentFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF14B8A6" Offset="0" />
        <GradientStop Color="#FF0284C7" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WidgetFocusAccent" Color="#FFDC2626" />
    <SolidColorBrush x:Key="WidgetOnStroke" Color="#FF2563EB" />
    <SolidColorBrush x:Key="WidgetWarning" Color="#FFD97706" />
</ResourceDictionary>
