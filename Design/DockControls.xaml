<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:OpenTaskbar.Views"
                    xmlns:local="clr-namespace:OpenTaskbar.Services">
    <Style x:Key="DockResizeThumb" TargetType="Thumb">
        <Setter Property="Width" Value="{StaticResource DockResizeGripWidth}" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" Width="{TemplateBinding Width}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Border x:Name="GripIndicator" Width="3" Height="14" CornerRadius="1.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource IndicatorBrush}" Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="GripScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GripIndicator" Property="Opacity" Value="0.65" />
                            <Setter TargetName="GripIndicator" Property="Height" Value="20" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="GripIndicator" Property="Opacity" Value="1.0" />
                            <Setter TargetName="GripIndicator" Property="Height" Value="28" />
                            <Setter TargetName="GripIndicator" Property="Width" Value="4" />
                            <Setter TargetName="GripIndicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DockButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="{DynamicResource DockCellSize}" />
        <Setter Property="Height" Value="{DynamicResource DockCellHeight}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.95" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="0"
                            CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="6" />
                            </Grid.RowDefinitions>
                            <!-- Aurora hover: a soft light pool under the icon instead of a hover box. -->
                            <Ellipse x:Name="HoverGlow" Grid.RowSpan="2" Margin="-6,0,-6,-4" Fill="{DynamicResource IconHoverGlow}"
                                     Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- Running apps get a short capsule; the foreground app a longer glowing one. -->
                            <Rectangle x:Name="ActiveIndicator" Grid.Row="1" Height="3" Width="8" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{DynamicResource IndicatorBrush}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="Transparent" />
                            <Setter TargetName="HoverGlow" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.48" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceKeyboardFocus}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ActiveIndicator" Property="Opacity" Value="0.55" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsForeground}" Value="True">
                            <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1.0" />
                            <Setter TargetName="ActiveIndicator" Property="Width" Value="16" />
                            <Setter TargetName="ActiveIndicator" Property="Fill" Value="{DynamicResource IndicatorForegroundBrush}" />
                            <Setter TargetName="ActiveIndicator" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#38BDF8" BlurRadius="8" ShadowDepth="0" Opacity="0.85" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockScrollViewerStyle" TargetType="{x:Type views:DockScrollViewer}">
        <Setter Property="AutomationProperties.HelpText" Value="{local:Loc ScrollDockHelp}" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="CanContentScroll" Value="False" />
        <Setter Property="PanningMode" Value="HorizontalOnly" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:DockScrollViewer}">
                    <Grid>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="False">
                            <ScrollContentPresenter.Content>
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Margin="{TemplateBinding Padding}" />
                            </ScrollContentPresenter.Content>
                        </ScrollContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
