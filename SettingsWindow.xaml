<Window x:Class="OpenTaskbar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenTaskbar.Services"
        Title="{local:Loc SettingsTitle}" Width="780" Height="700" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource SettingsBackground}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource InterfaceFont}" FontSize="{StaticResource TextSizeBody}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Design/SettingsControls.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid Background="{DynamicResource SettingsBackground}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Padding="24,20" BorderBrush="{DynamicResource MenuDivider}" BorderThickness="0,0,0,1">
            <StackPanel><TextBlock Text="OpenTaskbar" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{local:Loc SettingsIntro}" Style="{StaticResource SettingsDescription}" Margin="0,4,0,0" /></StackPanel>
        </Border>
        <TabControl Grid.Row="1" TabStripPlacement="Left" SelectedIndex="0">
            <TabItem Header="{local:Loc General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{StaticResource SettingsPageInset}">
                    <StackPanel>
                        <TextBlock Text="{local:Loc General}" Style="{StaticResource SettingsHeading}" />
                        <TextBlock Text="{local:Loc GeneralIntro}" Style="{StaticResource SettingsDescription}" Margin="0,0,0,12" />
                        <Border Style="{StaticResource SettingsRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0"><TextBlock Text="{local:Loc Startup}" FontWeight="SemiBold" /><TextBlock Text="{local:Loc StartupDescription}" Style="{StaticResource SettingsDescription}" Margin="0,4,0,0" /></StackPanel>
                            <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="{local:Loc Startup}" />
                        </Grid></Border>
                        <Border Style="{StaticResource SettingsRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0"><TextBlock Text="{local:Loc Animations}" FontWeight="SemiBold" /><TextBlock Text="{local:Loc AnimationsDescription}" Style="{StaticResource SettingsDescription}" Margin="0,4,0,0" /></StackPanel>
                            <CheckBox x:Name="AnimationsToggle" Grid.Column="1" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="{local:Loc Animations}" />
                        </Grid></Border>
                        <Border Style="{StaticResource SettingsRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0"><TextBlock Text="{local:Loc Previews}" FontWeight="SemiBold" /><TextBlock Text="{local:Loc PreviewsDescription}" Style="{StaticResource SettingsDescription}" Margin="0,4,0,0" /></StackPanel>
                            <CheckBox x:Name="PreviewsToggle" Grid.Column="1" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="{local:Loc Previews}" />
                        </Grid></Border>
                        <Border Style="{StaticResource SettingsRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0"><TextBlock Text="{local:Loc Badges}" FontWeight="SemiBold" /><TextBlock Text="{local:Loc BadgesDescription}" Style="{StaticResource SettingsDescription}" Margin="0,4,0,0" /></StackPanel>
                            <CheckBox x:Name="BadgesToggle" Grid.Column="1" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="{local:Loc Badges}" />
                        </Grid></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{local:Loc Appearance}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{StaticResource SettingsPageInset}">
                    <StackPanel>
                        <TextBlock Text="{local:Loc Appearance}" Style="{StaticResource SettingsHeading}" />
                        <TextBlock Text="{local:Loc AppearanceIntro}" Style="{StaticResource SettingsDescription}" Margin="0,0,0,12" />
                        <Border Style="{StaticResource SettingsRow}"><StackPanel>
                            <TextBlock Text="{local:Loc Theme}" FontWeight="SemiBold" /><TextBlock Text="{local:Loc ThemeDescription}" Style="{StaticResource SettingsDescription}" Margin="0,4,0,12" />
                            <WrapPanel><RadioButton x:Name="DarkTheme" GroupName="Theme" Content="{local:Loc Dark}" Style="{StaticResource SettingsChoice}" /><RadioButton x:Name="LightTheme" GroupName="Theme" Content="{local:Loc Light}" Style="{StaticResource SettingsChoice}" /></WrapPanel>
                        </StackPanel></Border>
                        <Border Style="{StaticResource SettingsRow}"><StackPanel>
                            <TextBlock Text="{local:Loc Language}" FontWeight="SemiBold" /><TextBlock Text="{local:Loc LanguageDescription}" Style="{StaticResource SettingsDescription}" Margin="0,4,0,12" />
                            <WrapPanel><RadioButton x:Name="TurkishLanguage" GroupName="Language" Content="Türkçe" Style="{StaticResource SettingsChoice}" /><RadioButton x:Name="EnglishLanguage" GroupName="Language" Content="English" Style="{StaticResource SettingsChoice}" /></WrapPanel>
                        </StackPanel></Border>
                        <Border Style="{StaticResource SettingsRow}"><StackPanel>
                            <TextBlock Text="{local:Loc Position}" FontWeight="SemiBold" /><TextBlock Text="{local:Loc PositionDescription}" Style="{StaticResource SettingsDescription}" Margin="0,4,0,12" />
                            <WrapPanel><RadioButton x:Name="LeftPosition" GroupName="Position" Content="{local:Loc Left}" Style="{StaticResource SettingsChoice}" /><RadioButton x:Name="CenterPosition" GroupName="Position" Content="{local:Loc Center}" Style="{StaticResource SettingsChoice}" /><RadioButton x:Name="RightPosition" GroupName="Position" Content="{local:Loc Right}" Style="{StaticResource SettingsChoice}" /></WrapPanel>
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{local:Loc Widgets}" IsEnabled="False" ToolTip="{local:Loc WidgetsUnavailable}" ToolTipService.ShowOnDisabled="True" />
        </TabControl>
        <Border Grid.Row="2" Padding="24,16" BorderBrush="{DynamicResource MenuDivider}" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatus" Text="{local:Loc SaveHint}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="1" Content="{local:Loc Apply}" Style="{StaticResource SettingsButton}" Click="Apply_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
