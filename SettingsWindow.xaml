<Window x:Class="OpenTaskbar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenTaskbar.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{local:Loc SettingsTitle}" Width="740" Height="600" MinWidth="560" MinHeight="440"
        WindowStyle="None" ResizeMode="CanResize" Background="Transparent"
        WindowStartupLocation="CenterScreen" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource InterfaceFont}" FontSize="{StaticResource TextSizeBody}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="-1" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Design/SettingsControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="SettingsFrame" Background="{DynamicResource SettingsGlassMaterial}"
            BorderBrush="{DynamicResource MenuStroke}" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="{local:Loc SettingsTitle}" Margin="20,0,148,0" FontWeight="SemiBold"
                           VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,6,5"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                            ToolTip="{local:Loc Minimize}" AutomationProperties.Name="{local:Loc Minimize}" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource MaximizeCaptionButton}" Click="Maximize_Click" />
                    <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Click="Close_Click"
                            ToolTip="{local:Loc Close}" AutomationProperties.Name="{local:Loc Close}" />
                </StackPanel>
            </Grid>
            <TabControl x:Name="SettingsTabs" Grid.Row="1" TabStripPlacement="Left" SelectedIndex="0">
                <TabItem Header="{local:Loc General}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <StackPanel Margin="{StaticResource SettingsPageInset}">
                            <TextBlock Text="{local:Loc General}" Style="{StaticResource SettingsHeading}" />
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="StartupToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc Startup}" AutomationProperties.HelpText="{local:Loc StartupDescription}" />
                                <TextBlock Text="{local:Loc Startup}" Style="{StaticResource SettingsRowLabel}" />
                            </DockPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="AnimationsToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc Animations}" AutomationProperties.HelpText="{local:Loc AnimationsDescription}" />
                                <TextBlock Text="{local:Loc Animations}" Style="{StaticResource SettingsRowLabel}" />
                            </DockPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="MagnificationToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc Magnification}" AutomationProperties.HelpText="{local:Loc MagnificationDescription}" />
                                <TextBlock Text="{local:Loc Magnification}" Style="{StaticResource SettingsRowLabel}" />
                            </DockPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="PreviewsToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc Previews}" AutomationProperties.HelpText="{local:Loc PreviewsDescription}" />
                                <TextBlock Text="{local:Loc Previews}" Style="{StaticResource SettingsRowLabel}" />
                            </DockPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="BadgesToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc Badges}" AutomationProperties.HelpText="{local:Loc BadgesDescription}" />
                                <TextBlock Text="{local:Loc Badges}" Style="{StaticResource SettingsRowLabel}" />
                            </DockPanel></Border>
                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Text="{local:Loc AutoHide}" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <RadioButton x:Name="AutoHideDisabled" GroupName="AutoHide" Content="{local:Loc AutoHideDisabled}" Style="{StaticResource SettingsListChoice}" />
                                <RadioButton x:Name="AutoHideSmart" GroupName="AutoHide" Content="{local:Loc AutoHideSmart}" Style="{StaticResource SettingsListChoice}" />
                                <RadioButton x:Name="AutoHideAlways" GroupName="AutoHide" Content="{local:Loc AutoHideAlways}" Style="{StaticResource SettingsListChoice}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{local:Loc Appearance}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <StackPanel Margin="{StaticResource SettingsPageInset}">
                            <TextBlock Text="{local:Loc Appearance}" Style="{StaticResource SettingsHeading}" />
                            <Border Style="{StaticResource SettingsChoiceRow}"><StackPanel>
                                <TextBlock Text="{local:Loc Theme}" Style="{StaticResource SettingsChoiceLabel}" />
                                <UniformGrid Columns="2" Margin="-3,0">
                                    <RadioButton x:Name="DarkTheme" GroupName="Theme" Content="{local:Loc Dark}" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="LightTheme" GroupName="Theme" Content="{local:Loc Light}" Style="{StaticResource SettingsChoice}" />
                                </UniformGrid>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SettingsChoiceRow}"><StackPanel>
                                <TextBlock Text="{local:Loc Language}" Style="{StaticResource SettingsChoiceLabel}" />
                                <UniformGrid Columns="2" Margin="-3,0">
                                    <RadioButton x:Name="TurkishLanguage" GroupName="Language" Content="Türkçe" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="EnglishLanguage" GroupName="Language" Content="English" Style="{StaticResource SettingsChoice}" />
                                </UniformGrid>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SettingsChoiceRow}"><StackPanel>
                                <TextBlock Text="{local:Loc DockSize}" Style="{StaticResource SettingsChoiceLabel}" ToolTip="{local:Loc DockSizeDescription}" />
                                <UniformGrid Columns="3" Margin="-3,0">
                                    <RadioButton x:Name="CompactSize" GroupName="DockSize" Content="{local:Loc SizeCompact}" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="MediumSize" GroupName="DockSize" Content="{local:Loc SizeMedium}" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="LargeSize" GroupName="DockSize" Content="{local:Loc SizeLarge}" Style="{StaticResource SettingsChoice}" />
                                </UniformGrid>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SettingsChoiceRow}"><StackPanel>
                                <TextBlock Text="{local:Loc Layout}" Style="{StaticResource SettingsChoiceLabel}" />
                                <UniformGrid Columns="2" Margin="-3,0">
                                    <RadioButton x:Name="FloatingLayout" GroupName="Layout" Content="{local:Loc LayoutFloating}" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="FullWidthLayout" GroupName="Layout" Content="{local:Loc LayoutFullWidth}" Style="{StaticResource SettingsChoice}" />
                                </UniformGrid>
                            </StackPanel></Border>
                            <Border x:Name="PositionRow" Style="{StaticResource SettingsChoiceRow}"><StackPanel>
                                <TextBlock Text="{local:Loc Position}" Style="{StaticResource SettingsChoiceLabel}" />
                                <UniformGrid Columns="3" Margin="-3,0">
                                    <RadioButton x:Name="LeftPosition" GroupName="Position" Content="{local:Loc Left}" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="CenterPosition" GroupName="Position" Content="{local:Loc Center}" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="RightPosition" GroupName="Position" Content="{local:Loc Right}" Style="{StaticResource SettingsChoice}" />
                                </UniformGrid>
                            </StackPanel></Border>
                            <StackPanel Margin="0,16,0,0">
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{local:Loc SurfaceOpacity}" FontWeight="SemiBold" />
                                </DockPanel>
                                <Slider x:Name="OpacitySlider" Minimum="60" Maximum="100" Value="90" TickFrequency="5"
                                        IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10" Style="{StaticResource SettingsOpacitySlider}"
                                        AutomationProperties.Name="{local:Loc SurfaceOpacity}" AutomationProperties.HelpText="{local:Loc SurfaceOpacityHelp}"
                                        ValueChanged="OpacitySlider_ValueChanged" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{local:Loc Widgets}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <StackPanel Margin="{StaticResource SettingsPageInset}">
                            <TextBlock Text="{local:Loc Widgets}" Style="{StaticResource SettingsHeading}" />
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="ClockToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc WidgetClock}" />
                                <TextBlock Text="{local:Loc WidgetClock}" Style="{StaticResource SettingsRowLabel}" />
                            </DockPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="MediaToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc WidgetMedia}" />
                                <TextBlock Text="{local:Loc WidgetMedia}" Style="{StaticResource SettingsRowLabel}" />
                            </DockPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="SystemStatsToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc WidgetSystemStats}" AutomationProperties.HelpText="{local:Loc WidgetSystemStatsDescription}" />
                                <TextBlock Text="{local:Loc WidgetSystemStats}" Style="{StaticResource SettingsRowLabel}" ToolTip="{local:Loc WidgetSystemStatsDescription}" />
                            </DockPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="AudioToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc WidgetAudio}" />
                                <TextBlock Text="{local:Loc WidgetAudio}" Style="{StaticResource SettingsRowLabel}" />
                            </DockPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="QuickSettingsToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc WidgetQuickSettings}" AutomationProperties.HelpText="{local:Loc WidgetQuickSettingsDescription}" />
                                <TextBlock Text="{local:Loc WidgetQuickSettings}" Style="{StaticResource SettingsRowLabel}" ToolTip="{local:Loc WidgetQuickSettingsDescription}" />
                            </DockPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="FocusToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc WidgetFocus}" />
                                <TextBlock Text="{local:Loc WidgetFocus}" Style="{StaticResource SettingsRowLabel}" />
                            </DockPanel></Border>
                            <StackPanel x:Name="FocusOptions" Margin="0,16,0,0">
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="FocusMinutesValue" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{local:Loc FocusDuration}" FontWeight="SemiBold" />
                                </DockPanel>
                                <Slider x:Name="FocusMinutesSlider" Minimum="1" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True"
                                        SmallChange="1" LargeChange="5" Style="{StaticResource SettingsOpacitySlider}"
                                        AutomationProperties.Name="{local:Loc FocusDuration}" ValueChanged="FocusSlider_ValueChanged" />
                                <DockPanel Margin="0,16,0,10">
                                    <TextBlock x:Name="BreakMinutesValue" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{local:Loc BreakDuration}" FontWeight="SemiBold" />
                                </DockPanel>
                                <Slider x:Name="BreakMinutesSlider" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                        SmallChange="1" LargeChange="5" Style="{StaticResource SettingsOpacitySlider}"
                                        AutomationProperties.Name="{local:Loc BreakDuration}" ValueChanged="FocusSlider_ValueChanged" />
                                <DockPanel Margin="0,16,0,10">
                                    <TextBlock x:Name="FocusSessionsValue" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{local:Loc FocusSessionCount}" FontWeight="SemiBold" />
                                </DockPanel>
                                <Slider x:Name="FocusSessionsSlider" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"
                                        SmallChange="1" LargeChange="2" Style="{StaticResource SettingsOpacitySlider}"
                                        AutomationProperties.Name="{local:Loc FocusSessionCount}" ValueChanged="FocusSlider_ValueChanged" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <Border Grid.Row="2" Padding="20,12" BorderBrush="{DynamicResource MenuDivider}" BorderThickness="0,1,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SaveStatus" Visibility="Collapsed" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="ApplyButton" Grid.Column="1" Content="{local:Loc Apply}" Style="{StaticResource SettingsButton}"
                            IsEnabled="False" Click="Apply_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
