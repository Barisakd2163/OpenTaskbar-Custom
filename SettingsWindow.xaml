<Window x:Class="OpenTaskbar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenTaskbar.Services"
        xmlns:widgets="clr-namespace:OpenTaskbar.Views.Widgets"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{local:Loc SettingsTitle}" Width="740" Height="600" MinWidth="560" MinHeight="440"
        WindowStyle="None" ResizeMode="CanResize" Background="Transparent"
        WindowStartupLocation="CenterScreen" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource InterfaceFont}" FontSize="{StaticResource TextSizeBody}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="-1" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="SettingsWidgetOptionTemplate">
                <widgets:WidgetCatalogItem InstallationRequested="WidgetInstallation_Click" />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="SettingsFrame" Background="{DynamicResource SettingsGlassMaterial}"
            BorderBrush="{DynamicResource MenuStroke}" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="{local:Loc SettingsTitle}" Margin="20,0,148,0" FontWeight="SemiBold"
                           VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,6,5"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                            ToolTip="{local:Loc Minimize}" AutomationProperties.Name="{local:Loc Minimize}" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource MaximizeCaptionButton}" Click="Maximize_Click" />
                    <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Click="Close_Click"
                            ToolTip="{local:Loc Close}" AutomationProperties.Name="{local:Loc Close}" />
                </StackPanel>
            </Grid>
            <TabControl x:Name="SettingsTabs" Grid.Row="1" TabStripPlacement="Left" SelectedIndex="0" SelectionChanged="SettingsTabs_SelectionChanged">
                <TabItem Header="{local:Loc General}" Tag="&#xE713;">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <StackPanel Margin="{StaticResource SettingsPageInset}">
                            <TextBlock Text="{local:Loc General}" Style="{StaticResource SettingsHeading}" />
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="StartupToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc Startup}" AutomationProperties.HelpText="{local:Loc StartupDescription}" />
                                <TextBlock Text="{local:Loc Startup}" Style="{StaticResource SettingsRowLabel}" />
                            </DockPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="AnimationsToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc Animations}" AutomationProperties.HelpText="{local:Loc AnimationsDescription}" />
                                <TextBlock Text="{local:Loc Animations}" Style="{StaticResource SettingsRowLabel}" />
                            </DockPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="MagnificationToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc Magnification}" AutomationProperties.HelpText="{local:Loc MagnificationDescription}" />
                                <TextBlock Text="{local:Loc Magnification}" Style="{StaticResource SettingsRowLabel}" />
                            </DockPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="PreviewsToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc Previews}" AutomationProperties.HelpText="{local:Loc PreviewsDescription}" />
                                <TextBlock Text="{local:Loc Previews}" Style="{StaticResource SettingsRowLabel}" />
                            </DockPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="BadgesToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc Badges}" AutomationProperties.HelpText="{local:Loc BadgesDescription}" />
                                <TextBlock Text="{local:Loc Badges}" Style="{StaticResource SettingsRowLabel}" />
                            </DockPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="RecycleBinToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc ShowRecycleBin}" />
                                <TextBlock Text="{local:Loc ShowRecycleBin}" Style="{StaticResource SettingsRowLabel}" />
                            </DockPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="AllMonitorsToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc AllMonitors}" AutomationProperties.HelpText="{local:Loc AllMonitorsDescription}" />
                                <TextBlock Text="{local:Loc AllMonitors}" Style="{StaticResource SettingsRowLabel}" ToolTip="{local:Loc AllMonitorsDescription}" />
                            </DockPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="CurrentDesktopToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc CurrentDesktopOnly}" AutomationProperties.HelpText="{local:Loc CurrentDesktopOnlyDescription}" />
                                <TextBlock Text="{local:Loc CurrentDesktopOnly}" Style="{StaticResource SettingsRowLabel}" ToolTip="{local:Loc CurrentDesktopOnlyDescription}" />
                            </DockPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="UpdatesToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc CheckUpdatesSetting}" />
                                <TextBlock Text="{local:Loc CheckUpdatesSetting}" Style="{StaticResource SettingsRowLabel}" />
                            </DockPanel></Border>
                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Text="{local:Loc AutoHide}" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <RadioButton x:Name="AutoHideDisabled" GroupName="AutoHide" Content="{local:Loc AutoHideDisabled}" Style="{StaticResource SettingsListChoice}" />
                                <RadioButton x:Name="AutoHideSmart" GroupName="AutoHide" Content="{local:Loc AutoHideSmart}" Style="{StaticResource SettingsListChoice}" />
                                <RadioButton x:Name="AutoHideAlways" GroupName="AutoHide" Content="{local:Loc AutoHideAlways}" Style="{StaticResource SettingsListChoice}" />
                            </StackPanel>
                            <StackPanel Margin="0,22,0,0">
                                <TextBlock Text="{local:Loc Backup}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{local:Loc BackupDescription}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{local:Loc ExportSettings}" Style="{StaticResource SettingsButton}" Click="ExportSettings_Click" Margin="0,0,8,0" />
                                    <Button Content="{local:Loc ImportSettings}" Style="{StaticResource SettingsButton}" Click="ImportSettings_Click" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{local:Loc Appearance}" Tag="&#xE790;">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <StackPanel Margin="{StaticResource SettingsPageInset}">
                            <TextBlock Text="{local:Loc Appearance}" Style="{StaticResource SettingsHeading}" />
                            <Border Style="{StaticResource SettingsChoiceRow}"><StackPanel>
                                <TextBlock Text="{local:Loc Theme}" Style="{StaticResource SettingsChoiceLabel}" />
                                <UniformGrid Columns="2" Margin="-3,0">
                                    <RadioButton x:Name="DarkTheme" GroupName="Theme" Content="{local:Loc Dark}" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="LightTheme" GroupName="Theme" Content="{local:Loc Light}" Style="{StaticResource SettingsChoice}" />
                                </UniformGrid>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SettingsChoiceRow}"><StackPanel>
                                <TextBlock Text="{local:Loc Language}" Style="{StaticResource SettingsChoiceLabel}" />
                                <UniformGrid Columns="2" Margin="-3,0">
                                    <RadioButton x:Name="TurkishLanguage" GroupName="Language" Content="Türkçe" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="EnglishLanguage" GroupName="Language" Content="English" Style="{StaticResource SettingsChoice}" />
                                </UniformGrid>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SettingsChoiceRow}"><StackPanel>
                                <TextBlock Text="{local:Loc DockSize}" Style="{StaticResource SettingsChoiceLabel}" ToolTip="{local:Loc DockSizeDescription}" />
                                <UniformGrid Columns="3" Margin="-3,0">
                                    <RadioButton x:Name="CompactSize" GroupName="DockSize" Content="{local:Loc SizeCompact}" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="MediumSize" GroupName="DockSize" Content="{local:Loc SizeMedium}" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="LargeSize" GroupName="DockSize" Content="{local:Loc SizeLarge}" Style="{StaticResource SettingsChoice}" />
                                </UniformGrid>
                                <DockPanel Margin="0,14,0,10">
                                    <TextBlock x:Name="DockScaleValue" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{local:Loc DockScale}" FontWeight="SemiBold" />
                                </DockPanel>
                                <Slider x:Name="DockScaleSlider" Minimum="75" Maximum="150" Value="100" TickFrequency="5"
                                        IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10" Style="{StaticResource SettingsOpacitySlider}"
                                        AutomationProperties.Name="{local:Loc DockScale}" AutomationProperties.HelpText="{local:Loc DockScaleHelp}"
                                        ValueChanged="DockScaleSlider_ValueChanged" />
                            </StackPanel></Border>
                            <Border Style="{StaticResource SettingsChoiceRow}"><StackPanel>
                                <TextBlock Text="{local:Loc DockEdge}" Style="{StaticResource SettingsChoiceLabel}" />
                                <UniformGrid Columns="3" Margin="-3,0">
                                    <RadioButton x:Name="BottomEdge" GroupName="DockEdge" Content="{local:Loc EdgeBottom}" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="LeftEdge" GroupName="DockEdge" Content="{local:Loc EdgeLeft}" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="RightEdge" GroupName="DockEdge" Content="{local:Loc EdgeRight}" Style="{StaticResource SettingsChoice}" />
                                </UniformGrid>
                            </StackPanel></Border>
                            <!-- One choice covers both: Left/Center/Right float the dock, Full width stretches it edge to edge. -->
                            <Border x:Name="PositionRow" Style="{StaticResource SettingsChoiceRow}"><StackPanel>
                                <TextBlock Text="{local:Loc DockAlignment}" Style="{StaticResource SettingsChoiceLabel}" ToolTip="{local:Loc DockAlignmentDescription}" />
                                <UniformGrid Columns="4" Margin="-3,0">
                                    <RadioButton x:Name="LeftPosition" GroupName="Position" Content="{local:Loc Left}" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="CenterPosition" GroupName="Position" Content="{local:Loc Center}" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="RightPosition" GroupName="Position" Content="{local:Loc Right}" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="FullWidthLayout" GroupName="Position" Content="{local:Loc LayoutFullWidth}" Style="{StaticResource SettingsChoice}" />
                                </UniformGrid>
                            </StackPanel></Border>
                            <StackPanel Margin="0,16,0,0">
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{local:Loc SurfaceOpacity}" FontWeight="SemiBold" />
                                </DockPanel>
                                <Slider x:Name="OpacitySlider" Minimum="60" Maximum="100" Value="90" TickFrequency="5"
                                        IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10" Style="{StaticResource SettingsOpacitySlider}"
                                        AutomationProperties.Name="{local:Loc SurfaceOpacity}" AutomationProperties.HelpText="{local:Loc SurfaceOpacityHelp}"
                                        ValueChanged="OpacitySlider_ValueChanged" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="WidgetsTab" Header="{local:Loc Widgets}" Tag="&#xEA86;">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                                  HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="{StaticResource SettingsPageInset}" MaxWidth="{StaticResource SettingsReadingWidth}">
                            <TextBlock Text="{local:Loc Widgets}" Style="{StaticResource SettingsHeading}" />
                            <TextBlock Text="{local:Loc WidgetSearch}" />
                            <TextBox x:Name="WidgetSearch" Style="{StaticResource WidgetSearchBox}"
                                     AutomationProperties.Name="{local:Loc WidgetSearch}" TextChanged="WidgetSearch_TextChanged" />
                            <ItemsControl x:Name="WidgetOptionsList" ItemTemplate="{StaticResource SettingsWidgetOptionTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="WidgetNoResults" Text="{local:Loc WidgetNoResults}" Visibility="Collapsed"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" AutomationProperties.LiveSetting="Polite" />
                            <StackPanel x:Name="ClockOptions" Margin="0,20,0,0">
                                <TextBlock Text="{local:Loc ClockSettingsHeading}" Style="{StaticResource SettingsHeading}" />
                                <Border Style="{StaticResource SettingsChoiceRow}"><StackPanel>
                                    <TextBlock Text="{local:Loc ClockFormatLabel}" Style="{StaticResource SettingsChoiceLabel}" />
                                    <UniformGrid Columns="2" Margin="-3,0">
                                        <RadioButton x:Name="Clock24HourRadio" GroupName="ClockFormat" Content="{local:Loc ClockFormat24Hour}" Style="{StaticResource SettingsChoice}" />
                                        <RadioButton x:Name="Clock12HourRadio" GroupName="ClockFormat" Content="{local:Loc ClockFormat12Hour}" Style="{StaticResource SettingsChoice}" />
                                    </UniformGrid>
                                </StackPanel></Border>
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <CheckBox x:Name="ClockSecondsToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                              AutomationProperties.Name="{local:Loc ClockShowSeconds}" />
                                    <TextBlock Text="{local:Loc ClockShowSeconds}" Style="{StaticResource SettingsRowLabel}" />
                                </DockPanel></Border>
                                <Border Style="{StaticResource SettingsChoiceRow}"><StackPanel>
                                    <TextBlock Text="{local:Loc ClockDateStyleLabel}" Style="{StaticResource SettingsChoiceLabel}" />
                                    <UniformGrid Columns="4" Margin="-3,0">
                                        <RadioButton x:Name="DateStyleDayShort" GroupName="ClockDateStyle" Content="{local:Loc DateStyleDayShort}" Style="{StaticResource SettingsChoice}" />
                                        <RadioButton x:Name="DateStyleShort" GroupName="ClockDateStyle" Content="{local:Loc DateStyleShort}" Style="{StaticResource SettingsChoice}" />
                                        <RadioButton x:Name="DateStyleNumeric" GroupName="ClockDateStyle" Content="{local:Loc DateStyleNumeric}" Style="{StaticResource SettingsChoice}" />
                                        <RadioButton x:Name="DateStyleHidden" GroupName="ClockDateStyle" Content="{local:Loc DateStyleHidden}" Style="{StaticResource SettingsChoice}" />
                                    </UniformGrid>
                                </StackPanel></Border>
                                <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                    <CheckBox x:Name="ClockWeatherToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                              AutomationProperties.Name="{local:Loc ClockShowWeather}" />
                                    <TextBlock Text="{local:Loc ClockShowWeather}" Style="{StaticResource SettingsRowLabel}" />
                                </DockPanel></Border>
                            </StackPanel>
                            <StackPanel x:Name="WeatherOptions" Margin="0,20,0,6">
                                <TextBlock Text="{local:Loc WeatherSettingsHeading}" Style="{StaticResource SettingsHeading}" />
                                <TextBlock Text="{local:Loc WeatherCity}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBox x:Name="WeatherCityBox" MaxLength="80" Padding="8,6" Background="{DynamicResource SettingsControl}"
                                         Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                                         BorderBrush="{DynamicResource MenuStroke}" TextChanged="WeatherCityBox_TextChanged"
                                         AutomationProperties.Name="{local:Loc WeatherCity}" AutomationProperties.HelpText="{local:Loc WeatherCityHint}" />
                                <TextBlock Text="{local:Loc WeatherCityHint}" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="FocusOptions" Margin="0,20,0,0">
                                <TextBlock Text="{local:Loc FocusSettingsHeading}" Style="{StaticResource SettingsHeading}" />
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="FocusMinutesValue" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{local:Loc FocusDuration}" FontWeight="SemiBold" />
                                </DockPanel>
                                <Slider x:Name="FocusMinutesSlider" Minimum="1" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True"
                                        SmallChange="1" LargeChange="5" Style="{StaticResource SettingsOpacitySlider}"
                                        AutomationProperties.Name="{local:Loc FocusDuration}" ValueChanged="FocusSlider_ValueChanged" />
                                <DockPanel Margin="0,16,0,10">
                                    <TextBlock x:Name="BreakMinutesValue" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{local:Loc BreakDuration}" FontWeight="SemiBold" />
                                </DockPanel>
                                <Slider x:Name="BreakMinutesSlider" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                        SmallChange="1" LargeChange="5" Style="{StaticResource SettingsOpacitySlider}"
                                        AutomationProperties.Name="{local:Loc BreakDuration}" ValueChanged="FocusSlider_ValueChanged" />
                                <DockPanel Margin="0,16,0,10">
                                    <TextBlock x:Name="FocusSessionsValue" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{local:Loc FocusSessionCount}" FontWeight="SemiBold" />
                                </DockPanel>
                                <Slider x:Name="FocusSessionsSlider" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"
                                        SmallChange="1" LargeChange="2" Style="{StaticResource SettingsOpacitySlider}"
                                        AutomationProperties.Name="{local:Loc FocusSessionCount}" ValueChanged="FocusSlider_ValueChanged" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{local:Loc Shortcuts}" Tag="&#xE765;">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <StackPanel Margin="{StaticResource SettingsPageInset}">
                            <TextBlock Text="{local:Loc Shortcuts}" Style="{StaticResource SettingsHeading}" />
                            <StackPanel>
                                <TextBlock Text="{local:Loc LauncherHotkey}" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <RadioButton x:Name="LauncherAltSpace" GroupName="LauncherHotkey" Content="Alt + Space" Style="{StaticResource SettingsListChoice}" />
                                <RadioButton x:Name="LauncherCtrlSpace" GroupName="LauncherHotkey" Content="Ctrl + Space" Style="{StaticResource SettingsListChoice}" />
                                <RadioButton x:Name="LauncherCtrlAltSpace" GroupName="LauncherHotkey" Content="Ctrl + Alt + Space" Style="{StaticResource SettingsListChoice}" />
                                <RadioButton x:Name="LauncherOff" GroupName="LauncherHotkey" Content="{local:Loc HotkeyDisabled}" Style="{StaticResource SettingsListChoice}" />
                            </StackPanel>
                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Text="{local:Loc DockHotkey}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{local:Loc DockHotkeyDescription}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <RadioButton x:Name="DockCtrlAltD" GroupName="DockHotkey" Content="Ctrl + Alt + D" Style="{StaticResource SettingsListChoice}" />
                                <RadioButton x:Name="DockWinAltD" GroupName="DockHotkey" Content="Win + Alt + D" Style="{StaticResource SettingsListChoice}" />
                                <RadioButton x:Name="DockOff" GroupName="DockHotkey" Content="{local:Loc HotkeyDisabled}" Style="{StaticResource SettingsListChoice}" />
                            </StackPanel>
                            <Border Style="{StaticResource SettingsChoiceRow}" Margin="0,18,0,0"><StackPanel>
                                <TextBlock Text="{local:Loc StartButton}" Style="{StaticResource SettingsChoiceLabel}" />
                                <UniformGrid Columns="2" Margin="-3,0">
                                    <RadioButton x:Name="StartOpensWindows" GroupName="StartAction" Content="{local:Loc StartWindows}" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="StartOpensLauncher" GroupName="StartAction" Content="{local:Loc StartLauncher}" Style="{StaticResource SettingsChoice}" />
                                </UniformGrid>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SettingsChoiceRow}"><StackPanel>
                                <TextBlock Text="{local:Loc StartPlacement}" Style="{StaticResource SettingsChoiceLabel}" />
                                <UniformGrid Columns="3" Margin="-3,0">
                                    <RadioButton x:Name="StartFirst" GroupName="StartPlacement" Content="{local:Loc PlacementStart}" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="StartLast" GroupName="StartPlacement" Content="{local:Loc PlacementEnd}" Style="{StaticResource SettingsChoice}" />
                                    <RadioButton x:Name="StartHidden" GroupName="StartPlacement" Content="{local:Loc PlacementHidden}" Style="{StaticResource SettingsChoice}" />
                                </UniformGrid>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SettingsRow}"><DockPanel>
                                <CheckBox x:Name="WheelVolumeToggle" DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}"
                                          AutomationProperties.Name="{local:Loc WheelVolume}" AutomationProperties.HelpText="{local:Loc WheelVolumeDescription}" />
                                <TextBlock Text="{local:Loc WheelVolume}" Style="{StaticResource SettingsRowLabel}" ToolTip="{local:Loc WheelVolumeDescription}" />
                            </DockPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <Border Grid.Row="2" Padding="20,12" BorderBrush="{DynamicResource MenuDivider}" BorderThickness="0,1,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SaveStatus" Visibility="Collapsed" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="ApplyButton" Grid.Column="1" Content="{local:Loc Apply}" Style="{StaticResource SettingsButton}"
                            IsEnabled="False" Click="Apply_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
